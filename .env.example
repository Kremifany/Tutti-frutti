# Local Postgres from docker compose. On Vercel, replace this with the cloud database URL.
DATABASE_URL=postgresql://tutti:tutti@localhost:5433/tutti_frutti

# openssl rand -base64 32
# On Vercel, BETTER_AUTH_URL is the public site, for example
# https://tutti-frutti-alpha.vercel.app
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# This email is the owner. Every other account is a parent.
# Google sign-in with this email also becomes the owner.
OWNER_EMAIL=owner@tuttifrutti.local
OWNER_PASSWORD=

# Google Cloud OAuth client. Authorized redirect:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe pricing tables. One table per class, built in the Stripe Dashboard.
# Each product is one class date. Put the date in the product name,
# for example "Расти 21.10.2026" or "Grow 21 October 2026 17:45".
# After payment, the app returns the parent to /account.
# Webhook: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICING_TABLE_LIVE_LETTERS=
STRIPE_PRICING_TABLE_GROW=
STRIPE_PRICING_TABLE_CONSONANCE=
STRIPE_PRICING_TABLE_ANIMAL_KINGDOM=
STRIPE_PRICING_TABLE_STORYTELLING=
